# Caddy для прод-стека Tyntro (deploy/docker-compose.prod.yml).
# Адрес сайта приходит из env DOMAIN (передаётся compose-файлом).
#  - настоящий домен: автоматический HTTPS Let's Encrypt (HTTP-01 + TLS-ALPN),
#    сертификат хранится в volume caddy_data и перевыпускается сам;
#  - localhost: локальный сертификат внутреннего CA Caddy (проверка curl -k).
#
# Почту для уведомлений Let's Encrypt можно задать блоком
#   { email ops@example.com }
# в начале файла — опционально.
{$DOMAIN} {
	encode zstd gzip

	# Анти-спуфинг заголовка страны для гео-блока (src/lib/security/geo.ts):
	# x-vercel-ip-country удаляем всегда — на своём сервере его может прислать
	# любой клиент, а Vercel перед этим стеком не стоит.
	request_header -x-vercel-ip-country

	# cf-ipcountry / cf-connecting-ip честно ставит только Cloudflare перед
	# сервером; от остальных адресов (прямой клиент) — удаляем.
	# Диапазоны Cloudflare: https://www.cloudflare.com/ips-v4 и /ips-v6,
	# снято 2026-10-10 (обновляйте при изменении списков).
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	request_header @not_cloudflare -cf-ipcountry -cf-connecting-ip

	# Caddy сам подставляет X-Forwarded-Proto/Host/For. Приложение берёт IP
	# из x-forwarded-for с TRUSTED_PROXY_COUNT=1 (последний элемент = клиент).
	# HSTS и остальные заголовки проставляет приложение (next.config.js).
	reverse_proxy web:3000
}
