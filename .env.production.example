# Tyntro — env для прод-деплоя (deploy/docker-compose.prod.yml).
#   cp .env.production.example .env.production   # и заполнить значения
# Файл содержит секреты: не коммитится (.gitignore), права 600
# (chmod 600 .env.production). Полное руководство — docs/DEPLOY.md.

## ── БД ──────────────────────────────────────────────────────────────
# Пароль Postgres: сгенерируйте `openssl rand -base64 24`.
POSTGRES_USER=props
POSTGRES_PASSWORD=
POSTGRES_DB=props
# Внутри docker-сети стека; пароль должен совпадать с POSTGRES_PASSWORD.
DATABASE_URL=postgresql://props:ПАРОЛЬ@db:5432/props

## ── Сайт / TLS (caddy) ──────────────────────────────────────────────
# Домен сайта; A-запись → IP сервера. Caddy сам выпустит сертификат
# Let's Encrypt (80/443 должны быть открыты). Для локальной проверки —
# localhost (локальный сертификат, curl -k), см. deploy/local-check.sh.
DOMAIN=props.example.com

## ── Приложение (web + worker) ───────────────────────────────────────
# Кошелёк-казна для оплат. ПУСТО на старте: сюда позже подставляется
# адрес мультисига Squads (2-of-3), см. чек-лист в docs/DEPLOY.md §6.
# Пустое значение = покупки недоступны (checkout вернёт ошибку), остальное
# работает.
TREASURY_WALLET=
# USDC mainnet (Circle). Совпадает с дефолтом кода — оставить как есть.
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# RPC Solana для подтверждения оплат и рыночных данных. Пусто → публичный
# api.mainnet-beta.solana.com (жёсткие лимиты; для прода рекомендуем платный
# RPC, например Helius — он уже в CSP next.config.js).
SOLANA_RPC_URL=
# Отдельный RPC только для подтверждения оплат; пусто → SOLANA_RPC_URL.
PAYMENTS_RPC_URL=
# Комиссия тейкера (доля): 0.0005 = 0.05%.
TAKER_FEE_RATE=0.0005

## ── Админ ───────────────────────────────────────────────────────────
# Кошелёк, который получит роль ADMIN при первом запуске миграций/сида.
# Меняется только до первого запуска; далее — SQL (docs/DEPLOY.md §3).
ADMIN_WALLET=

## ── SIWS-домены / IP / гео ──────────────────────────────────────────
# Белый список хостов для SIWS-сообщений (CSV). В проде ОБЯЗАТЕЛЕН
# (docs/REVIEW.md H2): иначе доменом подписи считается Host запроса как есть.
APP_DOMAINS=props.example.com
# Фолбэк-домен; пусто → первый из APP_DOMAINS.
APP_DOMAIN=
# IP клиента для rate-limit. С Cloudflare перед сервером (рекомендуется, см.
# docs/DEPLOY.md §8) — cf-connecting-ip: Caddy пропускает его только из сети
# Cloudflare. Без Cloudflare — x-forwarded-for (Caddy кладёт туда IP клиента).
# x-forwarded-for за Cloudflare даст IP узла Cloudflare — общий лимит на всех.
TRUSTED_IP_HEADER=cf-connecting-ip
TRUSTED_PROXY_COUNT=1
# Гео-блок, ISO-3166 alpha-2 через запятую. Пусто → дефолт кода:
# US,CU,IR,KP,SY,RU,BY.
BLOCKED_COUNTRIES=
# Заголовок, из которого приложение берёт страну клиента (docs/DEPLOY.md,
# раздел «Гео-блок»). Читается только он, на рестарте процесса. Дефолт без
# переменной: VERCEL=1 → x-vercel-ip-country, иначе cf-ipcountry. Caddy
# удаляет x-vercel-ip-country всегда, а cf-* — не из сети Cloudflare,
# поэтому подделать cf-ipcountry снаружи нельзя.
GEO_COUNTRY_HEADER=cf-ipcountry

## ── Бэкап ───────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=14

## ── Порты (нужно только для локальной проверки) ─────────────────────
# В проде не задавать: caddy публикует стандартные 80/443.
# deploy/local-check.sh подставляет HTTP_PORT=8080, HTTPS_PORT=8443.
#HTTP_PORT=
#HTTPS_PORT=

## ── NEXT_PUBLIC_* — инлайнятся в бандл ПРИ СБОРКЕ образа ────────────
# ВАЖНО: задание их в .env.production НЕ влияет на уже собранный образ —
# значения видит только сборщик (next build). Дефолты кода уже mainnet:
#   NEXT_PUBLIC_SOLANA_CLUSTER → 'mainnet-beta',
#   NEXT_PUBLIC_BRAND_NAME     → 'TYNTRO'.
# Менять (например, для devnet-теста checkout) нужно пересборкой образа
# с ENV, см. docs/DEPLOY.md §4.
#NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
#NEXT_PUBLIC_SOLANA_RPC_URL=
#NEXT_PUBLIC_SUPPORT_EMAIL=
#NEXT_PUBLIC_BRAND_NAME=

## ── Переменные локальных скриптов (scripts/*) ───────────────────────
# Не для прода, перечислены для полноты (grep process.env по scripts/):
#   BASE_URL, MN1, MN2     — scripts/devnet-real.ts (devnet-покупки)
#   BOTS, CMDS_PER_TICK, SEED, PRICES — scripts/bot-load.ts (нагрузка)
#   MINUTES                — scripts/record-prices.ts (запись цен)
#   DATABASE_URL           — scripts/e2e.ts, scripts/bot-load.ts
