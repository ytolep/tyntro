DATABASE_URL=postgresql://props:props@localhost:54339/props
# Публичный RPC для рыночных данных Phoenix (необязателен, есть дефолт).
SOLANA_RPC_URL=
# Кошелёк администратора для сидирования роли ADMIN (необязателен).
ADMIN_WALLET=

# SIWS-домены (docs/REVIEW.md H2): APP_DOMAINS — белый список хостов (CSV);
# production обязан задать, иначе Host запроса принимается как есть (dev/тесты).
# APP_DOMAIN — домен-фолбэк для Host вне списка (по умолчанию первый из APP_DOMAINS).
APP_DOMAINS=
APP_DOMAIN=

# IP клиента (docs/REVIEW.md M2): доверенный заголовок платформы (cf-connecting-ip /
# x-real-ip); без него — XFF, отсчитывая TRUSTED_PROXY_COUNT доверенных прокси с конца
# (по умолчанию 1 = последний элемент XFF).
TRUSTED_IP_HEADER=
TRUSTED_PROXY_COUNT=

# Гео-блок: ISO-3166 alpha-2 через запятую. Пусто/нет → дефолт US,CU,IR,KP,SY,RU,BY
BLOCKED_COUNTRIES=